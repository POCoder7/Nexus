{
  "name": "nexus-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/check-prod-build.mjs",
    "build:dev": "ng build --configuration development",
    "test": "ng test --watch=false",
    "lint": "stylelint \"src/**/*.css\" && node scripts/lint-selftest.mjs",
    "api:generate": "ng-openapi-gen",
    "api:check": "node scripts/check-api.mjs",
    "storybook": "ng run nexus-ui:storybook",
    "build-storybook": "ng run nexus-ui:build-storybook",
    "test:storybook": "node scripts/storybook-test.mjs",
    "e2e": "playwright test",
    "ci": "npm run lint && npm run api:check && npm test && npm run build && npm run build-storybook && npm run test:storybook"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.2",
    "@angular-devkit/architect": "0.2202.5",
    "@angular-devkit/core": "22.2.5",
    "@angular/animations": "22.2.3",
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/angular-vite": "10.6.5",
    "@storybook/test-runner": "0.26.0",
    "@types/node": "26.6.6",
    "axe-playwright": "2.2.2",
    "jsdom": "30.1.3",
    "ng-openapi-gen": "1.1.0",
    "prettier": "3.9.10",
    "storybook": "10.6.5",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
